# Pasta do conteúdo a ser indexado (o vault Obsidian)
WEBRAG_SOURCE_DIR=G:\Meu Drive\ContextDirectory\Web Engineer

# Onde o índice é gravado (fora do Google Drive de propósito)
# WEBRAG_INDEX_DIR=C:\Users\anils\projects\webengineer-rag\data\index

# Modelo de embedding multilíngue (roda offline depois do 1o download)
# Alternativa maior/melhor: intfloat/multilingual-e5-base
WEBRAG_EMBED_MODEL=intfloat/multilingual-e5-small

# Tamanho dos chunks (caracteres) e sobreposição
WEBRAG_CHUNK_CHARS=1200
WEBRAG_CHUNK_OVERLAP=200
# Seções menores que isso são fundidas com a seguinte
WEBRAG_CHUNK_MIN=400

